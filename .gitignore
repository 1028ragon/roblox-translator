# 환경 변수 및 로컬 인증 정보 (.env.example은 공유)
.env
.env.*
!.env.example

# Python 가상환경
.venv/
venv/
env/
ENV/

# Python 바이트코드 및 캐시
__pycache__/
*.py[cod]
*$py.class

# 테스트, 커버리지 및 정적 분석 캐시
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml

# 빌드 및 패키징 결과물
build/
dist/
.eggs/
*.egg-info/
*.egg

# IDE 개인 설정
.vscode/
.idea/

# 로그 및 임시 파일
*.log
logs/
*.tmp
*.temp
*.bak
*~

# 오디오 캡처 테스트 결과
/test.wav

# 운영체제 파일
.DS_Store
Thumbs.db
Desktop.ini

# GitHub 이슈 교체 백업 및 실행 기록
/.local/issue-migrations/
